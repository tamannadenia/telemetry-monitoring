# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Local SQLite database file (created automatically under prisma/)
DATABASE_URL="file:./dev.db"

# Offline detection threshold (milliseconds)
OFFLINE_THRESHOLD_MS=120000

# Scheduler interval for offline checks (milliseconds)
OFFLINE_CHECK_INTERVAL_MS=30000
